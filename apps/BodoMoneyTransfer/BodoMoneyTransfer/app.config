<?xml version="1.0"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="BodoMoneyTransfer.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
    </sectionGroup>

  </configSections>
  <applicationSettings>
    <BodoMoneyTransfer.Properties.Settings>
      <setting name="ArchivePath" serializeAs="String">
        <value>d:\temp\BodoMoneyTransfer\Archive</value>
      </setting>
      <setting name="ErrorMailer" serializeAs="String">
        <value>robert.leisner@bodoconsult.de</value>
      </setting>
      <setting name="QuotationFile" serializeAs="String">
        <value>d:\tmp\BodoMoneyTransfer\quotation.json</value>
      </setting>
      <setting name="DBConn" serializeAs="String">
        <value>Data Source=192.168.10.125;Initial Catalog=BodoMoneyTransfer;Trusted_Connection=True;</value>
      </setting>
      <setting name="OriginalArchivePath" serializeAs="String">
        <value>d:\temp\BodoMoneyTransfer\Originals</value>
      </setting>
      <setting name="BtfTransferDay" serializeAs="String">
        <value>3</value>
      </setting>
    </BodoMoneyTransfer.Properties.Settings>
  </applicationSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="PayPalAPISoapBinding">
          <security mode="Transport"/>
        </binding>
        <binding name="PayPalAPIAASoapBinding">
          <security mode="Transport"/>
        </binding>
        <binding name="PayPalAPISoapBinding1"/>
        <binding name="PayPalAPIAASoapBinding1"/>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="https://api-3t.paypal.com/2.0/" binding="basicHttpBinding" bindingConfiguration="PayPalAPISoapBinding" contract="PaypalServices.PayPalAPIInterface" name="PayPalAPI"/>
      <endpoint address="https://api-aa.paypal.com/2.0/" binding="basicHttpBinding" bindingConfiguration="PayPalAPIAASoapBinding" contract="PaypalServices.PayPalAPIAAInterface" name="PayPalAPIAA"/>
    </client>
  </system.serviceModel>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30AD4FE6B2A6AEED" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
